document.addEventListener("keydown", (e) => {
  if (e.key === "Escape"){ closeMenu(); if (filterTeacher) clearTeacherFilter(); }
});

function jumpTo(day){
  selectedDay = day;
  render();
  document.querySelector(".viewing-row").scrollIntoView({behavior:"smooth", block:"start"});
}

/* ============ main render ============ */
function render(){
  const now = new Date();
  const isActualToday = selectedDay === actualToday;
  const today = WEEK[selectedDay];
  const dayAccent = DAYMETA[selectedDay].accent;

  const hr = now.getHours();
  const greetWord = hr < 12 ? "Good morning" : hr < 17 ? "Good afternoon" : "Good evening";
  document.getElementById("greet").innerHTML = `${greetWord}, <span class="accentword">Raj</span>`;
  document.getElementById("dateLine").textContent = now.toLocaleDateString("en-US", { weekday:"long", day:"numeric", month:"long", year:"numeric" });
  document.getElementById("clock").textContent = now.toLocaleTimeString("en-US", { hour12:true });

  dsbDot.style.background = dayAccent;
  dsbLabel.textContent = today.label;
  dsbTag.style.display = isActualToday ? "inline-block" : "none";
  btn.style.setProperty("--dsaccent", dayAccent);

  const viewingNote = document.getElementById("viewingNote");
  if (!isActualToday){
    viewingNote.textContent = `You're looking at ${today.label}'s routine as a reference. Today is actually ${WEEK[actualToday].label}.`;
    viewingNote.classList.add("show");
  } else {
    viewingNote.classList.remove("show");
  }

  const scheduleZone = document.getElementById("scheduleZone");
  const glance = document.getElementById("glance");
  const banner = document.getElementById("banner");
  const legend = document.getElementById("legend");
  const progressTrack = document.getElementById("progressTrack");

  /* ---------- COMPARE-SECTIONS INLINE REPLACE ---------- */
  const todayPanelTitle = document.getElementById("todayPanelTitle");
  const todayPanelSub = document.getElementById("todayPanelSub");
  const cmpInlineBannerEl = document.getElementById("cmpInlineBanner");
  const showCmpInline = typeof cmpGroups !== "undefined" && cmpGroups.size === 1 && cmpMode === "inline";

  if (showCmpInline){
    const g = Array.from(cmpGroups)[0];
    if (cmpInlineBannerEl){
      cmpInlineBannerEl.innerHTML = `
        <div class="cmp-inline-banner">
          <div class="txt">Viewing <strong>${g}</strong>'s routine for ${cmpDay} instead of yours.</div>
          <div class="cmp-inline-actions">
            <button class="cmp-btn" onclick="cmpOpenPanel()">Open as separate panel instead</button>
            <button class="cmp-btn primary" onclick="cmpClear()">Back to my routine</button>
          </div>
        </div>`;
    }
    if (todayPanelTitle) todayPanelTitle.textContent = `${g} &middot; ${cmpDay}`;
    if (todayPanelSub) todayPanelSub.textContent = `Comparison view. This isn't your own routine.`;
    renderInlineCompare(g);
    buildWeekGrid();
    return;
  }
  if (cmpInlineBannerEl) cmpInlineBannerEl.innerHTML = "";
  if (todayPanelTitle) todayPanelTitle.textContent = isActualToday ? "Today's Routine" : `${today.label}'s Routine`;
  if (todayPanelSub) todayPanelSub.textContent = `${today.label} &middot; Grade XII 'D'`;

  /* ---------- HOLIDAY STATE ---------- */
  if (today.holiday || today.periods.length === 0){
    glance.innerHTML = "";
    banner.classList.remove("show");
    legend.innerHTML = "";
    progressTrack.innerHTML = "";
    document.getElementById("tickets").innerHTML = "";
    scheduleZone.querySelectorAll(".hero-card").forEach(n=>n.remove());
    scheduleZone.insertAdjacentHTML("beforeend", `
      <div class="hero-card" style="--accent:var(--holiday)">
        <div class="ring">${ICON.holiday}</div>
        <h2>No classes ${isActualToday ? "today" : `on ${today.label}`}</h2>
        <p>${today.label} is off the schedule. A good day to catch up on notes, rest, or get ahead on the coming week.</p>
      </div>`);
    buildWeekGrid();
    return;
  }
  scheduleZone.querySelectorAll(".hero-card").forEach(n=>n.remove());

  const periods = today.periods;
  const classCount = periods.filter(p => p.type === "class" || p.type === "lab").length;
  const hasLab = periods.some(p => p.type === "lab");
  const first = periods[0];
  const last = periods[periods.length - 1];
  const lunch = periods.find(p => p.type === "lunch");

  glance.innerHTML = `
    <div class="stat"><div class="lbl">Periods</div><div class="val">${classCount} <small>classes</small></div></div>
    <div class="stat"><div class="lbl">Hours</div><div class="val">${fmt12(first.s)} <small>&rarr; ${fmt12(last.e)}</small></div></div>
    ${lunch ? `<div class="stat"><div class="lbl">Lunch</div><div class="val">${fmt12(lunch.s)}</div></div>` : ""}
    <div class="stat"><div class="lbl">Lab session</div><div class="val">${hasLab ? "Yes" : "None"}</div></div>
  `;

  const withDates = periods.map(p => ({...p, sD: toDate(now, p.s), eD: toDate(now, p.e)}));
  const currentIdx = isActualToday ? withDates.findIndex(p => now >= p.sD && now < p.eD) : -1;
  const beforeSchool = isActualToday && now < withDates[0].sD;
  const afterSchool = isActualToday && now >= withDates[withDates.length - 1].eD;

  banner.classList.remove("show","info");
  if (beforeSchool){
    const mins = Math.ceil((withDates[0].sD - now) / 60000);
    banner.innerHTML = `School hasn't started yet. First period begins in <strong>${minsToText(mins)}</strong>, at ${fmt12(withDates[0].s)}.`;
    banner.classList.add("show");
  } else if (afterSchool){
    banner.innerHTML = `Classes are over for ${today.label.toLowerCase()}. See you next period, Raj.`;
    banner.classList.add("show");
  } else if (currentIdx !== -1 && (withDates[currentIdx].type === "break" || withDates[currentIdx].type === "lunch")){
    const mins = Math.ceil((withDates[currentIdx].eD - now) / 60000);
    const w = withDates[currentIdx].type === "lunch" ? "Lunch" : "Break";
    banner.innerHTML = `${w} time. Back to class in <strong>${minsToText(mins)}</strong>.`;
    banner.classList.add("show");
  }

  progressTrack.innerHTML = withDates.map((p,i) => {
    const color = p.type === "class" || p.type === "lab" ? ACCENT[p.code] : "var(--brk)";
    const status = isActualToday ? (i === currentIdx ? "now" : (now >= p.eD ? "done" : "")) : "";
    return `<span class="p-dot ${status}" style="--dotcolor:${color}" title="${p.s}"></span>`;
  }).join("");

  const ticketsEl = document.getElementById("tickets");
  ticketsEl.innerHTML = withDates.map((p, i) => {
    const isNow = isActualToday && i === currentIdx;
    const isDone = isActualToday && now >= p.eD;
    const isNext = isActualToday && !isNow && !isDone && withDates.slice(0,i).every(q => now >= q.eD);
    let stateClass = !isActualToday ? "is-plain" : (isNow ? "is-now" : (isDone ? "is-done" : (isNext ? "is-next" : "")));

    const teacherHtml = (teacher, code) => {
      if (teacher.includes(",")){
        const chips = teacher.split(",").map(t => t.trim()).map(t => {
          const key = teacherKey(code, t);
          return `<span class="tchip ${filterTeacher===key?'is-active':''}" data-key="${key}" onclick="event.stopPropagation();toggleTeacherFilter('${key}')">${t}</span>`;
        }).join("");
        return `<div class="teacherbox"><span class="tlabel">Teachers</span><div class="tchips">${chips}</div></div>`;
      }
      const t = teacher.trim();
      const key = teacherKey(code, t);
      return `<div class="teacherbox"><span class="tlabel">Teacher</span><span class="tname ${filterTeacher===key?'is-active':''}" data-key="${key}" onclick="event.stopPropagation();toggleTeacherFilter('${key}')">${t}</span></div>`;
    };

    if (p.type === "class" || p.type === "lab"){
      const accent = ACCENT[p.code];
      const fullname = p.subject || FULLNAME[p.code];
      let statusHtml = "";
      if (isNow){
        const mins = Math.ceil((p.eD - now)/60000);
        statusHtml = `<span class="pill now"><span class="dot"></span>Now</span><span class="countdown">${minsToText(mins)} left</span>`;
      } else if (isNext){
        const mins = Math.ceil((p.sD - now)/60000);
        statusHtml = `<span class="pill next">Next</span><span class="countdown">in ${minsToText(mins)}</span>`;
      }
      return `
        <div class="ticket ${stateClass}" style="--accent:${accent}">
          <div class="stub">
            <span class="start">${fmt12(p.s)}</span>
            <span class="end">${fmt12(p.e)}</span>
            <span class="plabel">Period ${i+1}</span>
          </div>
          <div class="perf"></div>
          <div class="body">
            <div class="badge">${p.code}</div>
            <div class="info">
              <h3>${fullname}</h3>
              ${p.type === "lab" ? `<span class="lab-tag">Lab &middot; double period</span>` : ""}
            </div>
            ${teacherHtml(p.teacher, p.code)}
            <div class="status">${statusHtml}</div>
          </div>
        </div>`;
    } else {
      const accent = p.type === "study" ? "var(--study)" : "var(--brk)";
      const label = LABEL[p.type];
      let statusHtml = "";
      if (isNow){
        const mins = Math.ceil((p.eD - now)/60000);
        statusHtml = `<span class="pill now"><span class="dot"></span>Now</span><span class="countdown">${minsToText(mins)} left</span>`;
      } else if (isNext){
        statusHtml = `<span class="pill next">Next</span>`;
      }
      return `
        <div class="ticket compact ${stateClass}" style="--accent:${accent}">
          <div class="stub">
            <span class="start">${fmt12(p.s)}</span>
            <span class="end">${fmt12(p.e)}</span>
          </div>
          <div class="perf"></div>
          <div class="body">
            <div class="badge">${ICON[p.type]}</div>
            <div class="info"><h3>${label}</h3></div>
            <div class="status">${statusHtml}</div>
          </div>
        </div>`;
    }
  }).join("");

  const seen = new Map();
  periods.forEach(p => { if (p.code) seen.set(p.code, FULLNAME[p.code]); });
  let legendHtml = "";
  seen.forEach((name, code) => {
    legendHtml += `<span class="item"><span class="sw" style="background:${ACCENT[code]}"></span>${name}</span>`;
  });
  if (periods.some(p=>p.type==="break")) legendHtml += `<span class="item"><span class="sw" style="background:var(--brk)"></span>Break</span>`;
  if (periods.some(p=>p.type==="lunch")) legendHtml += `<span class="item"><span class="sw" style="background:var(--brk)"></span>Lunch</span>`;
  if (periods.some(p=>p.type==="study")) legendHtml += `<span class="item"><span class="sw" style="background:var(--study)"></span>Study Hour</span>`;
  legend.innerHTML = legendHtml;

  buildWeekGrid();
}

/* ============ full-week aesthetic grid (transposed: days as rows, periods as columns) ============ */
function buildWeekGrid(){
  const grid = document.getElementById("weekGrid");
  let html = `<div class="wg-corner"></div>`;

  // time headers (top row)
  ROWTIMES.forEach((r, i) => {
    const isBreak = i === 2 || i === 8;
    html += `<div class="wg-timelabel ${isBreak?'is-break':''}" style="grid-column:${i+2};grid-row:1">${fmt12(r.s)}&ndash;${fmt12(r.e)}</div>`;
  });

  // day headers (left column)
  Object.keys(WEEK).forEach(k => {
    const d = Number(k);
    const meta = WEEK[d];
    const accent = DAYMETA[d].accent;
    const cls = ["wg-head"];
    if (d === actualToday) cls.push("is-today");
    if (d === selectedDay) cls.push("is-selected");
    const tag = meta.holiday ? "Off" : (meta.note ? "Online" : "");
    html += `<div class="${cls.join(' ')}" style="grid-column:1;grid-row:${d+2};--hcol:${accent}" onclick="jumpTo(${d})">
      <div class="wgh-day">${DAYMETA[d].short}</div>
      ${tag ? `<div class="wgh-tag">${tag}</div>` : ""}
    </div>`;
  });

  // day rows
  Object.keys(WEEK).forEach(k => {
    const d = Number(k);
    const meta = WEEK[d];
    const rowStyle = d === actualToday ? ` wg-row-today` : "";

    if (meta.holiday || meta.periods.length === 0){
      if (meta.holiday){
        html += `<div class="wg-cell wg-holiday${rowStyle}" style="grid-row:${d+2};grid-column:2 / span 11">Holiday</div>`;
      } else {
        // e.g. Sunday: fill mapped periods, then filler for the rest
        meta.periods.forEach(p => {
          const {col, span} = colRange(p);
          html += renderWgCell(p, d, col, span, rowStyle);
        });
        const lastP = meta.periods[meta.periods.length-1];
        const lastCol = colRange(lastP);
        const usedThrough = lastCol.col + lastCol.span; // next free column
        const remaining = 13 - usedThrough; // columns go 2..12
        if (remaining > 0){
          html += `<div class="wg-cell wg-filler${rowStyle}" style="grid-row:${d+2};grid-column:${usedThrough} / span ${remaining}">Free</div>`;
        }
      }
      return;
    }

    meta.periods.forEach(p => {
      const {col, span} = colRange(p);
      html += renderWgCell(p, d, col, span, rowStyle);
    });
  });

  grid.innerHTML = html;
  applyTeacherFilter();
}

function renderWgCell(p, d, col, span, rowStyle){
  const gridStyle = `grid-row:${d+2};grid-column:${col} / span ${span};`;
  if (p.type === "break"){
    return `<div class="wg-cell wg-break${rowStyle}" style="${gridStyle}"></div>`;
  }
  if (p.type === "lunch"){
    return `<div class="wg-cell wg-lunch${rowStyle}" style="${gridStyle}--ccol:var(--brk)"><span class="wc-code">Lunch</span></div>`;
  }
  if (p.type === "study"){
    return `<div class="wg-cell wg-study${rowStyle}" style="${gridStyle}--ccol:var(--study)"><span class="wc-code">Study</span></div>`;
  }
  const accent = ACCENT[p.code];
  const teacherLabel = p.teacher.includes(',') ? p.teacher.split(',').length + ' teachers' : p.teacher;
  const keys = p.teacher.split(',').map(t => teacherKey(p.code, t)).join(',');
  return `<div class="wg-cell${rowStyle}" data-teacherkeys="${keys}" style="${gridStyle}--ccol:${accent}" onclick="wgCellClick(this)">
    <span class="wc-code">${p.code}${p.type==='lab' ? ' Lab' : ''}</span>
    <span class="wc-teacher">${teacherLabel}</span>
  </div>`;
}

function wgCellClick(el){
  const keys = (el.dataset.teacherkeys || "").split(",").map(s=>s.trim()).filter(Boolean);
  if (keys.length === 0) return;
  const k = keys.includes(filterTeacher) ? filterTeacher : keys[0];
  toggleTeacherFilter(k);
}

