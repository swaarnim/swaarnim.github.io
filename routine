  cmpMode = "panel";
  document.getElementById("comparePanel").setAttribute("data-open","true");
  buildComparePanel(); render();
}

function buildComparePanel(){
  const el = document.getElementById("comparePanelBody");
  if (!el) return;

  const dayBtns = COMPARE_DAYS.map(d => `<button class="cmp-daybtn ${d===cmpDay?'is-active':''}" onclick="cmpSetDay('${d}')">${d}</button>`).join("");
  const groupsForDay = COMPARE[cmpDay] ? Object.keys(COMPARE[cmpDay].groups) : [];
  const groupChips = groupsForDay.map(g => `<span class="cmp-groupchip ${cmpGroups.has(g)?'is-active':''}" onclick="cmpToggleGroup('${g}')">${g}</span>`).join("");

  el.innerHTML = `
    <p style="color:var(--chalk-dim);font-size:13px;margin:0 0 14px;line-height:1.5;">
      Pick a day and one or more sections to see their routine here. Choosing exactly one section
      replaces your own routine above by default. Use "Open as separate panel instead" up there,
      or pick more than one section, to keep your own routine untouched and see the comparison here instead.
    </p>
    <div class="cmp-label">Day</div>
    <div class="cmp-row">${dayBtns}</div>
    <div class="cmp-label">Section${groupsForDay.length ? "" : " (none found for this day)"}</div>
    <div class="cmp-groups">${groupChips}</div>
    <div class="cmp-toolbar">
      <div class="cmp-view-toggle">
        <button class="${cmpView==='grid'?'is-active':''}" onclick="cmpSetView('grid')">Grid</button>
        <button class="${cmpView==='list'?'is-active':''}" onclick="cmpSetView('list')">List</button>
      </div>
      ${cmpGroups.size ? `<button class="cmp-clear" onclick="cmpClear()">Stop comparing</button>` : ""}
    </div>
    <div class="cmp-results" id="cmpResults"></div>
  `;
  renderCmpResults();
}

function cmpRenderCell(raw){
  const text = (raw || "-").trim() || "-";
  if (isMutedCell(text)){
    return `<td><span class="cmp-cell cmp-muted">${/^free/i.test(text) || text === "-" ? "Free" : text}</span></td>`;
  }
  return `<td><span class="cmp-cell" style="--cc:${cmpCellAccent(text)}">${text}</span></td>`;
}
function cmpCellText(text){
  text = (text || "-").trim() || "-";
  return (/^free/i.test(text) || text === "-") ? "Free" : text;
}

function renderCmpResults(){
  const el = document.getElementById("cmpResults");
  if (!el) return;
  if (cmpGroups.size === 0){
    el.innerHTML = `<p class="cmp-empty">Select at least one section above to see its schedule.</p>`;
    return;
  }
  const dayData = COMPARE[cmpDay];
  if (!dayData){ el.innerHTML = `<p class="cmp-empty">No data found for ${cmpDay}.</p>`; return; }

  const groupsArr = Array.from(cmpGroups);

  if (cmpView === "grid"){
    const times = dayData.times;
    const rows = times.map((t, ti) => {
      const cells = groupsArr.map(g => cmpRenderCell(dayData.groups[g] ? dayData.groups[g][ti] : "-")).join("");
      return `<tr><td class="cmp-time">${t}</td>${cells}</tr>`;
    }).join("");
    const headCells = groupsArr.map(g => `<th>${g}</th>`).join("");
    el.innerHTML = `<div style="overflow-x:auto;"><table class="cmp-table"><thead><tr><th>Time</th>${headCells}</tr></thead><tbody>${rows}</tbody></table></div>`;
  } else {
    el.innerHTML = groupsArr.map(g => {
      const cells = dayData.groups[g] || [];
      const rows = dayData.times.map((t, ti) => `<div class="cmp-list-row"><span class="cmp-time">${t}</span><span>${cmpCellText(cells[ti])}</span></div>`).join("");
      return `<div class="cmp-list-card"><h3>${g} &middot; ${cmpDay}</h3>${rows}</div>`;
    }).join("");
  }
}

function renderInlineCompare(group){
  document.getElementById("glance").innerHTML = "";
  document.getElementById("banner").classList.remove("show");
  document.getElementById("progressTrack").innerHTML = "";
  document.getElementById("legend").innerHTML = "";
  document.getElementById("scheduleZone").querySelectorAll(".hero-card").forEach(n => n.remove());

  const dayData = COMPARE[cmpDay];
  const times = dayData ? dayData.times : [];
  const cells = dayData && dayData.groups[group] ? dayData.groups[group] : [];

  document.getElementById("tickets").innerHTML = times.map((t, i) => {
    const raw = (cells[i] || "-").trim() || "-";
    const muted = isMutedCell(raw);
    const accent = muted ? "var(--brk)" : cmpCellAccent(raw);
    const parts = t.split("-");
    const code = muted ? "" : (raw.split(/[\s(]/)[0] || "").slice(0, 6);
    const label = muted ? (/^free/i.test(raw) || raw === "-" ? "Free Period" : raw) : raw;
    return `
      <div class="ticket compact is-plain" style="--accent:${accent}">
        <div class="stub"><span class="start">${fmt12(parts[0])}</span><span class="end">${parts[1] ? fmt12(parts[1]) : ""}</span></div>
        <div class="perf"></div>
        <div class="body">
          <div class="badge">${muted ? ICON.break : code}</div>
          <div class="info"><h3>${label}</h3></div>
        </div>
      </div>`;
  }).join("");
}

