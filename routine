function cmpSetDay(d){ cmpDay = d; buildComparePanel(); render(); }
function cmpToggleGroup(g){
  if (cmpGroups.has(g)) cmpGroups.delete(g); else cmpGroups.add(g);
  buildComparePanel(); render();
}
function cmpSetView(v){ cmpView = v; buildComparePanel(); }
function cmpClear(){ cmpGroups.clear(); cmpMode = "inline"; buildComparePanel(); render(); }
