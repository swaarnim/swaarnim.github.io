function parseCompareData(md){
  const data = {};
  let currentDay = null;
  md.split("\n").forEach(rawLine => {
    const line = rawLine.trim();
    const dayMatch = line.match(/^###\s+\*\*(.+?)\*\*$/);
    if (dayMatch){
      currentDay = dayMatch[1].trim();
      data[currentDay] = { times: [], groups: {} };
      return;
    }
    if (!currentDay || !line.startsWith("|")) return;
    let cells = line.split("|").map(c => c.trim());
    if (cells[0] === "") cells.shift();
    if (cells[cells.length - 1] === "") cells.pop();
    if (cells.length === 0) return;
    if (cells[0] === "Group"){ data[currentDay].times = cells.slice(1); return; }
    if (/^:?-+:?$/.test(cells[0])) return;
    if (cells[0].startsWith("**")){
      const groupName = cells[0].replace(/\*\*/g, "").trim();
      data[currentDay].groups[groupName] = cells.slice(1);
    }
  });
  return data;
}

