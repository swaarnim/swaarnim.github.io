<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Raj's Routine — Grade XII 'D'</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500&family=IBM+Plex+Mono:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg-deep:#0e2419;
    --bg-mid:#153327;
    --panel:#123024;
    --chalk:#f6f1e4;
    --chalk-dim:#cddccf;
    --ink:#182a20;
    --ink-soft:#4b5c52;
    --rule: rgba(246,241,228,.14);

    --eng:#e4577b;
    --nep:#c1443c;
    --math:#6c5ce7;
    --phy:#2f80ed;
    --chem:#e8912d;
    --bot:#3fae6a;
    --zoo:#17a398;
    --bio:#1fa885;
    --brk:#8b958e;
    --lunch:#f0b429;
    --study:#7c8db5;
    --holiday:#c97b84;
    --online:#4fb3bf;
  }

  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    min-height:100vh;
    background:
      radial-gradient(1100px 600px at 12% -10%, rgba(255,255,255,.05), transparent 60%),
      linear-gradient(180deg,var(--bg-deep), var(--bg-mid) 55%, var(--bg-deep));
    background-attachment:fixed;
    color:var(--chalk);
    font-family:'Inter',sans-serif;
    -webkit-font-smoothing:antialiased;
    padding:clamp(18px,4vw,54px) 16px 90px;
  }

  .page{max-width:840px;margin:0 auto;}

  /* ---------- HEADER ---------- */
  .kicker{
    font-family:'IBM Plex Mono',monospace;
    font-size:11.5px;
    letter-spacing:.14em;
    text-transform:uppercase;
    color:var(--chalk-dim);
    display:flex;align-items:center;gap:8px;flex-wrap:wrap;
  }
  .kicker .yr{
    font-family:'IBM Plex Mono',monospace;
    background:rgba(246,241,228,.08);
    border:1px solid var(--rule);
    padding:2px 7px;border-radius:20px;
    font-size:11px;letter-spacing:.04em;
  }

  h1.greet{
    font-family:'Fraunces',serif;
    font-weight:600;
    font-size:clamp(32px,6.4vw,50px);
    line-height:1.04;
    margin:10px 0 6px;
    letter-spacing:-.01em;
  }
  h1.greet .accentword{
    font-style:italic;
    font-weight:500;
    color:#ffd9a8;
  }

  .subline{
    display:flex;flex-wrap:wrap;align-items:baseline;gap:10px;
    color:var(--chalk-dim);
    font-size:15px;
    margin-bottom:18px;
  }
  .subline .clock{
    font-family:'IBM Plex Mono',monospace;
    color:var(--chalk);
    background:rgba(246,241,228,.08);
    border:1px solid var(--rule);
    padding:3px 10px;border-radius:8px;
    font-size:13.5px;letter-spacing:.03em;
  }

  /* ---------- DAY PICKER (custom dropdown) ---------- */
  .viewing-row{
    display:flex;align-items:center;gap:10px;flex-wrap:wrap;
    margin-bottom:6px;
  }
  .viewing-label{
    font-family:'IBM Plex Mono',monospace;
    font-size:11px;letter-spacing:.1em;text-transform:uppercase;
    color:var(--chalk-dim);
  }

  .day-select{position:relative;display:inline-block;}
  .day-select__btn{
    display:flex;align-items:center;gap:9px;
    background:rgba(246,241,228,.07);
    border:1px solid var(--rule);
    color:var(--chalk);
    padding:9px 14px 9px 12px;
    border-radius:13px;
    cursor:pointer;
    font-family:'Fraunces',serif;
    font-weight:600;
    font-size:16px;
    transition:background .2s ease, border-color .2s ease, transform .15s ease;
  }
  .day-select__btn:hover{background:rgba(246,241,228,.12);}
  .day-select__btn:focus-visible{outline:2px solid var(--chalk);outline-offset:2px;}
  .day-select__btn.open{border-color:var(--dsaccent, var(--chalk));transform:translateY(-1px);}
  .dsb-dot{width:10px;height:10px;border-radius:50%;background:var(--dsaccent,var(--chalk));flex:0 0 auto;}
  .dsb-tag{
    font-family:'IBM Plex Mono',monospace;font-weight:500;font-size:10.5px;
    letter-spacing:.06em;text-transform:uppercase;
    color:var(--ink);
    background:var(--dsaccent,var(--chalk));
    padding:2px 7px;border-radius:99px;
  }
  .day-select__btn .chev{width:13px;height:13px;stroke:var(--chalk-dim);stroke-width:2.4;transition:transform .2s ease;}
  .day-select__btn.open .chev{transform:rotate(180deg);}

  .day-select__menu{
    position:absolute;top:calc(100% + 10px);left:0;
    width:272px;max-width:80vw;
    background:var(--chalk);
    border-radius:16px;
    box-shadow:0 22px 50px -14px rgba(0,0,0,.55), 0 2px 8px rgba(0,0,0,.25);
    padding:8px;
    list-style:none;margin:0;
    z-index:40;
    opacity:0;transform:translateY(-6px) scale(.98);
    pointer-events:none;
    transition:opacity .16s ease, transform .16s ease;
  }
  .day-select__menu.open{opacity:1;transform:translateY(0) scale(1);pointer-events:auto;}

  .day-opt{
    display:flex;align-items:center;gap:10px;
    padding:9px 10px;border-radius:11px;
    cursor:pointer;color:var(--ink);
    border-bottom:1px dashed rgba(24,42,32,.13);
  }
  .day-opt:last-child{border-bottom:none;}
  .day-opt:hover, .day-opt.focused{background:color-mix(in srgb, var(--optaccent) 16%, white 84%);}
  .day-opt.selected{background:color-mix(in srgb, var(--optaccent) 22%, white 78%);}
  .do-dot{width:11px;height:11px;border-radius:50%;background:var(--optaccent);flex:0 0 auto;box-shadow:0 0 0 3px color-mix(in srgb, var(--optaccent) 20%, transparent);}
  .do-main{flex:1 1 auto;}
  .do-name{font-family:'Fraunces',serif;font-weight:600;font-size:14.5px;line-height:1.2;}
  .do-note{font-family:'IBM Plex Mono',monospace;font-size:10px;color:var(--ink-soft);letter-spacing:.03em;}
  .do-check{width:16px;height:16px;stroke:var(--ink);stroke-width:2.6;opacity:0;flex:0 0 auto;}
  .day-opt.selected .do-check{opacity:1;}
  .do-today{
    font-family:'IBM Plex Mono',monospace;font-size:9px;letter-spacing:.07em;text-transform:uppercase;
    background:var(--ink);color:var(--chalk);
    padding:2px 6px;border-radius:99px;
  }

  .viewing-note{
    font-size:13px;color:var(--chalk-dim);margin:10px 0 0;
    display:none;
  }
  .viewing-note.show{display:block;}

  /* ---------- GLANCE STRIP ---------- */
  .glance{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(128px,1fr));
    gap:10px;
    margin:22px 0 6px;
  }
  .glance .stat{
    background:var(--panel);
    border:1px solid var(--rule);
    border-radius:14px;
    padding:13px 14px;
  }
  .glance .stat .lbl{
    font-family:'IBM Plex Mono',monospace;
    font-size:10.5px;text-transform:uppercase;letter-spacing:.1em;
    color:var(--chalk-dim);
    margin-bottom:5px;
  }
  .glance .stat .val{
    font-family:'Fraunces',serif;
    font-weight:600;
    font-size:19px;
    color:var(--chalk);
  }
  .glance .stat .val small{font-family:'Inter';font-weight:500;font-size:12px;color:var(--chalk-dim);}

  /* ---------- STATUS BANNER ---------- */
  .banner{
    margin:22px 0 8px;
    padding:14px 16px;
    border-radius:14px;
    font-size:14.5px;
    border:1px dashed var(--rule);
    background:rgba(246,241,228,.05);
    color:var(--chalk-dim);
    display:none;
  }
  .banner.show{display:block;}
  .banner strong{color:var(--chalk);}
  .banner.info{border-style:solid;background:rgba(79,179,191,.08);border-color:rgba(79,179,191,.3);}

  /* ---------- PROGRESS DOTS ---------- */
  .progress-track{
    display:flex;align-items:center;
    margin:30px 2px 18px;
    position:relative;
  }
  .progress-track::before{
    content:"";position:absolute;left:8px;right:8px;top:50%;
    height:0;border-top:2px dashed var(--rule);
    transform:translateY(-50%);
    z-index:0;
  }
  .p-dot{
    position:relative;z-index:1;
    width:14px;height:14px;border-radius:50%;
    background:var(--bg-mid);
    border:2px solid var(--rule);
    margin-right:auto;
    flex:0 0 auto;
    transition:transform .25s ease;
  }
  .p-dot.done{background:var(--dotcolor,var(--chalk-dim));border-color:var(--dotcolor,var(--chalk-dim));opacity:.55;}
  .p-dot.now{
    background:var(--dotcolor,var(--chalk));
    border-color:var(--dotcolor,var(--chalk));
    transform:scale(1.5);
    box-shadow:0 0 0 5px color-mix(in srgb, var(--dotcolor,var(--chalk)) 25%, transparent);
    animation:pulse 1.8s ease-in-out infinite;
  }
  @keyframes pulse{
    0%,100%{box-shadow:0 0 0 4px color-mix(in srgb, var(--dotcolor,var(--chalk)) 22%, transparent);}
    50%{box-shadow:0 0 0 8px color-mix(in srgb, var(--dotcolor,var(--chalk)) 8%, transparent);}
  }

  /* ---------- TICKETS ---------- */
  .tickets{display:flex;flex-direction:column;gap:14px;}

  .ticket{
    position:relative;
    display:grid;
    grid-template-columns:104px 22px 1fr;
    background:var(--panel);
    border-radius:16px;
    overflow:hidden;
    border:1px solid var(--rule);
    opacity:.62;
    filter:grayscale(.15);
    transition:opacity .3s ease, filter .3s ease, transform .3s ease;
  }
  .ticket.is-now{
    opacity:1;filter:none;
    box-shadow:0 10px 28px -10px color-mix(in srgb, var(--accent) 55%, black 10%);
    transform:translateY(-1px);
  }
  .ticket.is-next{opacity:.92;filter:none;}
  .ticket.is-done{opacity:.4;}
  .ticket.is-plain{opacity:1;filter:none;}

  .ticket .stub{
    background:var(--accent);
    color:var(--ink);
    padding:14px 10px;
    display:flex;flex-direction:column;justify-content:center;align-items:flex-start;
    font-family:'IBM Plex Mono',monospace;
  }
  .ticket .stub .start{font-size:16px;font-weight:600;line-height:1.15;}
  .ticket .stub .end{font-size:11.5px;opacity:.75;margin-top:1px;}
  .ticket .stub .plabel{
    margin-top:8px;font-size:9.5px;letter-spacing:.09em;text-transform:uppercase;
    opacity:.75;
  }

  .perf{
    position:relative;
    background:transparent;
    border-left:2px dashed rgba(246,241,228,.28);
    border-right:2px dashed rgba(246,241,228,.28);
  }
  .perf::before,.perf::after{
    content:"";position:absolute;left:50%;transform:translateX(-50%);
    width:16px;height:16px;border-radius:50%;
    background:var(--bg-mid);
  }
  .perf::before{top:-8px;}
  .perf::after{bottom:-8px;}

  .ticket .body{
    padding:13px 16px 13px 14px;
    display:flex;align-items:center;gap:10px;flex-wrap:wrap;
    background:var(--chalk);
    color:var(--ink);
  }
  .badge{
    flex:0 0 auto;
    width:42px;height:42px;border-radius:11px;
    display:flex;align-items:center;justify-content:center;
    background:color-mix(in srgb, var(--accent) 16%, white 84%);
    border:1.5px solid color-mix(in srgb, var(--accent) 55%, white 45%);
    color:color-mix(in srgb, var(--accent) 78%, black 22%);
    font-family:'IBM Plex Mono',monospace;
    font-weight:600;font-size:11.5px;letter-spacing:.02em;
  }
  .badge svg{width:19px;height:19px;stroke:currentColor;}

  .info{flex:1 1 120px;min-width:0;}
  .info h3{
    font-family:'Fraunces',serif;font-weight:600;
    font-size:17px;margin:0 0 2px;color:var(--ink);
    letter-spacing:-.005em;
  }
  .info p{
    margin:0;font-size:11.5px;color:var(--ink-soft);
    font-family:'IBM Plex Mono',monospace;
    text-transform:uppercase;letter-spacing:.06em;
  }
  .info .lab-tag{
    display:inline-block;margin-top:5px;
    font-family:'IBM Plex Mono',monospace;
    font-size:9.5px;letter-spacing:.08em;text-transform:uppercase;
    background:color-mix(in srgb, var(--accent) 18%, white 82%);
    color:color-mix(in srgb, var(--accent) 70%, black 30%);
    border:1px solid color-mix(in srgb, var(--accent) 45%, white 55%);
    padding:2px 7px;border-radius:6px;
  }

  /* ---- dedicated teacher box ---- */
  .teacherbox{
    flex:0 0 auto;
    display:flex;flex-direction:column;align-items:center;justify-content:center;
    min-width:66px;
    padding:6px 12px 7px;
    border-radius:11px;
    background:color-mix(in srgb, var(--accent) 9%, white 91%);
    border:1.5px solid color-mix(in srgb, var(--accent) 45%, white 55%);
  }
  .teacherbox .tlabel{
    font-family:'IBM Plex Mono',monospace;font-size:8.5px;letter-spacing:.13em;
    text-transform:uppercase;color:var(--ink-soft);margin-bottom:2px;
  }
  .teacherbox .tname{
    font-family:'IBM Plex Mono',monospace;font-weight:700;font-size:18px;
    color:color-mix(in srgb, var(--accent) 78%, black 22%);letter-spacing:.02em;
    line-height:1.1;
    cursor:pointer;border-radius:6px;padding:1px 4px;margin:-1px -4px;
    transition:background .15s ease, transform .15s ease;
  }
  .teacherbox .tname:hover{background:color-mix(in srgb, var(--accent) 24%, white 76%);transform:translateY(-1px);}
  .teacherbox .tname.is-active{background:color-mix(in srgb, var(--accent) 32%, white 68%);box-shadow:0 0 0 2px color-mix(in srgb, var(--accent) 55%, transparent);}
  .teacherbox .tchips{display:flex;flex-wrap:wrap;gap:4px;justify-content:center;}
  .teacherbox .tchip{
    font-family:'IBM Plex Mono',monospace;font-weight:700;font-size:12px;
    cursor:pointer;transition:background .15s ease, transform .15s ease;
    color:color-mix(in srgb, var(--accent) 78%, black 22%);
    background:color-mix(in srgb, var(--accent) 14%, white 86%);
    border:1px solid color-mix(in srgb, var(--accent) 40%, white 60%);
    padding:1px 6px;border-radius:6px;
  }
  .teacherbox .tchip:hover{transform:translateY(-1px);background:color-mix(in srgb, var(--accent) 26%, white 74%);}
  .teacherbox .tchip.is-active{background:color-mix(in srgb, var(--accent) 34%, white 66%);box-shadow:0 0 0 2px color-mix(in srgb, var(--accent) 55%, transparent);}

  .status{flex:0 0 auto;text-align:right;margin-left:auto;}
  .status .pill{
    font-family:'IBM Plex Mono',monospace;
    font-size:10px;letter-spacing:.09em;text-transform:uppercase;
    padding:4px 9px;border-radius:99px;
    display:inline-flex;align-items:center;gap:5px;
  }
  .pill.now{background:#e8483a;color:#fff8f2;}
  .pill.now .dot{width:6px;height:6px;border-radius:50%;background:#fff;animation:blink 1.1s ease-in-out infinite;}
  @keyframes blink{0%,100%{opacity:1;}50%{opacity:.25;}}
  .pill.next{background:color-mix(in srgb, var(--accent) 20%, white 80%);color:color-mix(in srgb, var(--accent) 75%, black 25%);}
  .status .countdown{
    display:block;margin-top:5px;font-size:11px;color:var(--ink-soft);
    font-family:'IBM Plex Mono',monospace;
  }

  .ticket.compact .body{padding:9px 16px 9px 14px;}
  .ticket.compact .badge{width:34px;height:34px;border-radius:9px;}
  .ticket.compact .info h3{font-size:14px;}

  /* ---------- HERO (holiday / no more school) ---------- */
  .hero-card{
    margin-top:26px;
    padding:34px 26px;
    border-radius:20px;
    text-align:center;
    background:var(--panel);
    border:1px solid var(--rule);
  }
  .hero-card .ring{
    width:64px;height:64px;margin:0 auto 16px;border-radius:50%;
    display:flex;align-items:center;justify-content:center;
    background:color-mix(in srgb, var(--accent) 20%, transparent);
    border:2px solid var(--accent);
  }
  .hero-card .ring svg{width:28px;height:28px;stroke:var(--accent);}
  .hero-card h2{
    font-family:'Fraunces',serif;font-weight:600;font-size:24px;margin:0 0 8px;
  }
  .hero-card p{color:var(--chalk-dim);font-size:14.5px;max-width:44ch;margin:0 auto;line-height:1.55;}

  /* ---------- LEGEND ---------- */
  .legend{
    margin-top:34px;
    display:flex;flex-wrap:wrap;gap:8px 14px;
    padding:16px 16px;
    border-radius:14px;
    border:1px solid var(--rule);
    background:rgba(246,241,228,.04);
  }
  .legend .item{
    display:flex;align-items:center;gap:7px;
    font-family:'IBM Plex Mono',monospace;
    font-size:11.5px;color:var(--chalk-dim);
  }
  .legend .sw{width:10px;height:10px;border-radius:3px;}

  /* ---------- FULL WEEK PANEL ---------- */
  .week-panel{margin-top:52px;}
  .week-panel__head{margin-bottom:16px;}
  .week-panel__head h2{
    font-family:'Fraunces',serif;font-weight:600;font-size:24px;margin:0 0 4px;
  }
  .week-panel__head p{margin:0;color:var(--chalk-dim);font-size:13.5px;}

  .week-scroll{
    border-radius:20px;
    border:1px solid var(--rule);
    background:var(--panel);
    padding:14px 8px;
  }
  .week-grid{
    display:grid;
    grid-template-columns:52px 1fr 1fr 0.42fr 1fr 1fr 1fr 1fr 1fr 0.42fr 1fr 1fr;
    gap:3px;
    width:100%;
  }
  .wg-corner{
    grid-column:1;grid-row:1;
  }
  .wg-head{
    padding:8px 3px;border-radius:11px;text-align:center;cursor:pointer;
    display:flex;flex-direction:column;align-items:center;justify-content:center;
    background:color-mix(in srgb, var(--hcol) 16%, transparent);
    border:1.5px solid color-mix(in srgb, var(--hcol) 45%, transparent);
    transition:transform .15s ease, background .15s ease;
  }
  .wg-head:hover{transform:translateX(2px);background:color-mix(in srgb, var(--hcol) 26%, transparent);}
  .wg-head.is-today{box-shadow:0 0 0 2px var(--hcol);}
  .wg-head .wgh-day{
    font-family:'Fraunces',serif;font-weight:600;font-size:clamp(10.5px,2.6vw,13.5px);color:var(--chalk);
  }
  .wg-head .wgh-tag{
    font-family:'IBM Plex Mono',monospace;font-size:clamp(6.5px,1.6vw,8.5px);letter-spacing:.06em;text-transform:uppercase;
    color:var(--chalk-dim);margin-top:1px;
  }
  .wg-head.is-selected{outline:2px dashed var(--chalk);outline-offset:2px;}

  .wg-timelabel{
    display:flex;align-items:center;justify-content:center;
    padding:4px 2px;text-align:center;
    font-family:'IBM Plex Mono',monospace;
    font-size:clamp(6.5px,1.6vw,9px);color:var(--chalk-dim);
    line-height:1.2;
  }
  .wg-timelabel.is-break{color:var(--chalk-dim);opacity:.6;font-style:italic;font-size:clamp(6px,1.4vw,8px);}

  .wg-row-today{
    background:rgba(246,241,228,.035);
    border-radius:10px;
  }

  .wg-cell{
    border-radius:10px;
    padding:5px 3px;
    display:flex;flex-direction:column;align-items:center;justify-content:center;
    gap:2px;
    min-height:44px;
    background:color-mix(in srgb, var(--ccol) 14%, white 86%);
    border:1px solid color-mix(in srgb, var(--ccol) 40%, white 60%);
    color:var(--ink);
    text-align:center;
    overflow:hidden;
  }
  .wg-cell .wc-code{
    font-family:'IBM Plex Mono',monospace;font-weight:700;font-size:clamp(8px,2vw,11.5px);
    color:color-mix(in srgb, var(--ccol) 78%, black 22%);
    white-space:nowrap;
  }
  .wg-cell .wc-teacher{
    font-family:'IBM Plex Mono',monospace;font-size:clamp(6.5px,1.6vw,9px);color:var(--ink-soft);
    white-space:nowrap;
  }
  .wg-cell.wg-break{background:rgba(139,149,142,.14);border:1px dashed rgba(139,149,142,.4);min-height:22px;}
  .wg-cell.wg-lunch .wc-code, .wg-cell.wg-study .wc-code{font-size:clamp(7px,1.8vw,10px);}
  .wg-cell.wg-filler{background:rgba(246,241,228,.04);border:1px dashed var(--rule);color:var(--chalk-dim);font-family:'IBM Plex Mono',monospace;font-size:clamp(8px,1.8vw,10.5px);}
  .wg-cell.wg-holiday{background:color-mix(in srgb, var(--holiday) 16%, transparent);border:1px dashed color-mix(in srgb, var(--holiday) 55%, transparent);color:var(--chalk-dim);font-family:'Fraunces',serif;font-weight:600;font-size:clamp(10px,2.4vw,13px);}

  .wg-cell[data-teachers]{cursor:pointer;}
  .wg-cell .wc-teacher{cursor:pointer;transition:text-decoration .15s ease;}
  .wg-cell .wc-teacher:hover{text-decoration:underline;}

  /* ---------- teacher spotlight filter state ---------- */
  .week-grid.filtering .wg-cell{transition:opacity .25s ease, transform .25s ease, filter .25s ease, box-shadow .25s ease;}
  .week-grid.filtering .wg-cell.wg-dim{opacity:.22;filter:grayscale(65%);transform:scale(.97);}
  .week-grid.filtering .wg-head{transition:opacity .25s ease, filter .25s ease;}
  .week-grid.filtering .wg-head.wg-dim{opacity:.35;filter:grayscale(70%);}
  .wg-cell.wg-match{
