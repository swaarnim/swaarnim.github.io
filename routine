const LABEL = { break:"Short Break", lunch:"Lunch Break", study:"Study Hour" };

/* ============ helpers ============ */
function pad(n){ return n.toString().padStart(2,"0"); }
function toDate(base, hm){
  const [h,m] = hm.split(":").map(Number);
  const d = new Date(base);
  d.setHours(h, m, 0, 0);
  return d;
}
function fmt12(hm){
  let [h,m] = hm.split(":").map(Number);
  const suf = h >= 12 ? "PM" : "AM";
  h = h % 12; if (h === 0) h = 12;
  return `${h}:${pad(m)} ${suf}`;
}
function minsToText(mins){
  if (mins < 1) return "less than a minute";
  const h = Math.floor(mins/60), m = mins % 60;
  if (h > 0) return `${h}h ${m}m`;
  return `${m}m`;
}
function colRange(p){
  const s = ROWTIMES.findIndex(r => r.s === p.s);
  const e = ROWTIMES.findIndex(r => r.e === p.e);
  return { col: s + 2, span: (e - s) + 1 };
}
function teacherKey(code, teacher){
  return `${code}::${teacher.trim()}`;
}

/* ============ state ============ */
const actualToday = new Date().getDay();
let selectedDay = actualToday;
let filterTeacher = null;

/* ============ teacher index (built once from WEEK) — keyed by subject so same-initial teachers in different subjects never mix ============ */
function buildTeacherIndex(){
  const idx = {};
  Object.keys(WEEK).forEach(k => {
    const d = Number(k);
    (WEEK[d].periods || []).forEach(p => {
      if (!p.teacher) return;
      p.teacher.split(",").map(t => t.trim()).forEach(t => {
        const key = teacherKey(p.code, t);
        if (!idx[key]) idx[key] = [];
        idx[key].push({ day: d, ...p, initials: t });
      });
    });
  });
  return idx;
}
const TEACHER_INDEX = buildTeacherIndex();
const TEACHER_KEYS = Object.keys(TEACHER_INDEX).sort((a,b) => TEACHER_INDEX[b].length - TEACHER_INDEX[a].length || a.localeCompare(b));

/* ============ teacher spotlight / filter ============ */
function toggleTeacherFilter(key){
  filterTeacher = (filterTeacher === key) ? null : key;
  applyTeacherFilter();
  if (filterTeacher){
    const panel = document.getElementById("weekPanel");
    if (panel){
      panel.setAttribute("data-open","true");
      panel.scrollIntoView({ behavior: "smooth", block: "start" });
    }
  }
}

/* ============ collapsible panels ============ */
function togglePanel(id){
  const panel = document.getElementById(id);
  if (!panel) return;
  const isOpen = panel.getAttribute("data-open") === "true";
  panel.setAttribute("data-open", isOpen ? "false" : "true");
}
function clearTeacherFilter(){
  filterTeacher = null;
  applyTeacherFilter();
}
function applyTeacherFilter(){
  const grid = document.getElementById("weekGrid");
  const spotlight = document.getElementById("teacherSpotlight");
  if (!grid || !spotlight) return;

  if (!filterTeacher){
    grid.classList.remove("filtering");
    grid.querySelectorAll(".wg-cell, .wg-head").forEach(c => c.classList.remove("wg-match","wg-dim"));
    spotlight.classList.remove("show");
    spotlight.innerHTML = "";
    document.querySelectorAll(".tname.is-active, .tchip.is-active").forEach(el => el.classList.remove("is-active"));
    document.querySelectorAll(".tdir-chip.is-active").forEach(el => el.classList.remove("is-active"));
    return;
  }

  grid.classList.add("filtering");
  const daysWithMatch = new Set();
  grid.querySelectorAll(".wg-cell").forEach(c => {
    const keys = (c.dataset.teacherkeys || "").split(",").map(s => s.trim()).filter(Boolean);
    if (keys.includes(filterTeacher)){
      c.classList.add("wg-match"); c.classList.remove("wg-dim");
      const dayIdx = Number(c.style.gridRow) - 2;
      daysWithMatch.add(dayIdx);
    } else {
      c.classList.add("wg-dim"); c.classList.remove("wg-match");
    }
  });
  grid.querySelectorAll(".wg-head").forEach(h => {
    const d = Number(h.getAttribute("onclick").match(/\d+/)[0]);
    if (daysWithMatch.has(d)) h.classList.remove("wg-dim"); else h.classList.add("wg-dim");
  });

  // keep the ticket / chip that triggered this in sync visually
  document.querySelectorAll(".tname, .tchip").forEach(el => {
    el.classList.toggle("is-active", el.dataset.key === filterTeacher);
  });
  document.querySelectorAll(".tdir-chip").forEach(el => {
    el.classList.toggle("is-active", el.dataset.teacher === filterTeacher);
  });

  const [subjCode, initials] = filterTeacher.split("::");
  const subjName = FULLNAME[subjCode] || subjCode;
  const sessions = (TEACHER_INDEX[filterTeacher] || []).slice().sort((a,b) => a.day - b.day || a.s.localeCompare(b.s));
  const rows = sessions.map(s => {
    const subj = s.subject || FULLNAME[s.code] || s.code;
    return `
      <div class="tsp-row">
        <span class="tsp-day" style="--dcol:${DAYMETA[s.day].accent}">${DAYMETA[s.day].short}</span>
        <span class="tsp-time">${fmt12(s.s)}&ndash;${fmt12(s.e)}</span>
        <span class="tsp-subj">${subj}${s.type === "lab" ? " <em>&middot; Lab</em>" : ""}</span>
      </div>`;
  }).join("");

  spotlight.innerHTML = `
    <div class="tsp-head">
      <div class="tsp-title"><span class="tsp-dot" style="background:${ACCENT[subjCode] || 'var(--online)'}"></span>Teacher spotlight &middot; <strong>${initials}</strong> <span class="tsp-forsubj">&middot; ${subjName}</span></div>
      <button class="tsp-close" onclick="clearTeacherFilter()">Clear filter &times;</button>
    </div>
    <div class="tsp-sub">${sessions.length} period${sessions.length === 1 ? "" : "s"} a week, highlighted above. Everything else is dimmed.</div>
    <div class="tsp-rows">${rows}</div>
  `;
  spotlight.classList.add("show");
}

function buildTeacherDirectory(){
  const el = document.getElementById("teacherDirectory");
  if (!el) return;

  const regularKeys = TEACHER_KEYS.filter(key => TEACHER_INDEX[key].some(s => s.type !== "lab"));
  const labKeys = TEACHER_KEYS.filter(key => TEACHER_INDEX[key].some(s => s.type === "lab"));

  const chipFor = (key, countFilter) => {
    const sessions = TEACHER_INDEX[key].filter(countFilter);
    const subjCode = sessions[0].code;
    const initials = sessions[0].initials;
    const accent = ACCENT[subjCode] || "var(--online)";
    return `<span class="tdir-chip ${filterTeacher===key?'is-active':''}" data-teacher="${key}" style="--dccol:${accent}" onclick="toggleTeacherFilter('${key}')">
      <span class="tdc-dot"></span>${initials}<span class="tdc-count">${subjCode} &middot; ${sessions.length}</span>
    </span>`;
  };

  const regularChips = regularKeys.map(key => chipFor(key, s => s.type !== "lab")).join("");
  const labChips = labKeys.map(key => chipFor(key, s => s.type === "lab")).join("");

  el.innerHTML = `
    <div class="tdir__head">
      <h2>Teacher Directory</h2>
      <p>Tap any teacher to spotlight every period they take this week. Lab-only teachers are listed separately below, since a lab session is not counted as a regular period.</p>
    </div>
    <div class="tdir__grid">${regularChips}</div>
    ${labChips ? `
    <div class="tdir__head" style="margin-top:18px;">
      <h2 style="font-size:15px;">Lab Teachers</h2>
      <p>Teachers who supervise a lab session this week.</p>
    </div>
    <div class="tdir__grid">${labChips}</div>` : ""}
  `;
}

/* ============ day picker ============ */
const btn = document.getElementById("daySelectBtn");
const menu = document.getElementById("daySelectMenu");
const dsbDot = document.getElementById("dsbDot");
const dsbLabel = document.getElementById("dsbLabel");
const dsbTag = document.getElementById("dsbTag");

function buildMenu(){
  menu.innerHTML = Object.keys(WEEK).map(k => {
