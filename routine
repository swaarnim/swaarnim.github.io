const CMP_ACCENT_MAP = [
  [/^maths?/i, "var(--math)"],
  [/^chem/i, "var(--chem)"],
  [/^phy/i, "var(--phy)"],
  [/^bot/i, "var(--bot)"],
  [/^zoo/i, "var(--zoo)"],
  [/^bio/i, "var(--bio)"],
  [/^nep/i, "var(--nep)"],
  [/^eng/i, "var(--eng)"],
  [/^comp/i, "var(--online)"],
  [/^value/i, "var(--study)"],
];
function cmpCellAccent(text){
  for (const [re, color] of CMP_ACCENT_MAP){ if (re.test(text)) return color; }
  return "var(--holiday)";
}
function isMutedCell(text){
  return /^lunch break$/i.test(text) || /^study hour$/i.test(text) || text === "-" || text === "" || /^free/i.test(text);
}

